<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>zotero-item-type-converter@yourname.com</em:id>
    <em:name>Zotero Item Type Converter</em:name>
    <em:version>1.2.0</em:version>
    <em:type>2</em:type>
    <em:description>Convert Zotero items to different types with field preservation</em:description>
    <em:creator>Your Name</em:creator>
    <em:bootstrap>true</em:bootstrap>

    <em:targetApplication>
      <Description>
        <em:id>zotero@chnm.gmu.edu</em:id>
        <em:minVersion>7.0</em:minVersion>
        <em:maxVersion>7.*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
